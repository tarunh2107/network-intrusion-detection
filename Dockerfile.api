# Dockerfile for NIDS FastAPI Inference Backend
# Explicit Python 3.11 slim base image
FROM python:3.11-slim

# Prevent Python from writing .pyc files and enable unbuffered logging
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

# Create non-root user and application directories
RUN useradd -m -u 1000 appuser && \
    mkdir -p /app/data /app/models /app/reports && \
    chown -R appuser:appuser /app

WORKDIR /app

# Install API service dependencies
COPY docker/requirements-api.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source code with non-root ownership
COPY --chown=appuser:appuser app /app/app

# Switch to non-root user
USER appuser

# API listens on 0.0.0.0:8000 with a single worker
EXPOSE 8000

CMD ["uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
