# Network Intrusion Detection & Monitoring Configuration
#
# Configuration is resolved from environment variables with fallback to
# this .env file if present in the project root. Relative paths are resolved
# relative to the project root directory.
#
# NOTE: The default values below are configured for LOCAL DEVELOPMENT and testing,
# not for production deployment.

# Backend REST API Network Binding (FastAPI / Uvicorn)
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Machine Learning Artifacts (Local, verified)
MODEL_PATH=models/baseline_v1/model.joblib
FROZEN_CONFIG_PATH=models/baseline_v1/frozen_evaluation_config.json

# SQLite Prediction History Database
# Note: Database transactions provide atomic writes, not guaranteed request deduplication.
# Retried prediction requests can create duplicate database records.
DATABASE_PATH=data/predictions.db

# Streamlit Security Dashboard Configuration
API_BASE_URL=http://127.0.0.1:8000
EVALUATION_REPORT_PATH=reports/generated/test_evaluation.json
DEMO_CSV_PATH=data/demo/example_flows.csv
DEMO_CSV_1000_PATH=data/demo/example_flows_1000.csv
